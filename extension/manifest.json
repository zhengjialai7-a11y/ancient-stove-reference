{
  "manifest_version": 3,
  "name": "美术绘制参考 · 原图采集助手",
  "version": "0.7.3",
  "description": "本机原图下载、云端上传核验和逐张关联；支持三幅作品试跑",
  "permissions": [
    "downloads",
    "tabs",
    "storage",
    "scripting",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.ltfc.net/*",
    "https://zhengjialai7-a11y.github.io/ancient-stove-reference/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "美术绘制参考 · 收藏采集队列"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://g2.ltfc.net/view/*"
      ],
      "js": [
        "download_bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.ltfc.net/resource_favorites*"
      ],
      "js": [
        "favorites_bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.ltfc.net/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://zhengjialai7-a11y.github.io/ancient-stove-reference/queue.html*"
      ],
      "js": [
        "sync_bridge.js",
        "local_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://g2.ltfc.net/view/*"
      ],
      "js": [
        "download_observer.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}
